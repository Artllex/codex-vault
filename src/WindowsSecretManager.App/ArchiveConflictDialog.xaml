<Window x:Class="WindowsSecretManager.App.ArchiveConflictDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex Vault" Icon="Assets/codex-vault-selected.ico" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#0B0D14" Foreground="#F4F6FC">
 <Grid Margin="26,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="10" Background="#2A2115" Margin="0,0,14,0"><TextBlock Text="!" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#E5C98B" FontSize="19"/></Border><TextBlock x:Name="HeadingText" VerticalAlignment="Center" Foreground="#F4F6FC" FontSize="19" FontWeight="SemiBold"/></StackPanel>
  <TextBlock x:Name="MessageText" Grid.Row="1" Margin="52,16,0,24" Foreground="#C7CCDA" FontSize="14"/>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" MinWidth="92" Click="Cancel_Click"/><Button x:Name="SkipButton" MinWidth="92" Click="Skip_Click"/><Button x:Name="ReplaceButton" MinWidth="110" Style="{StaticResource PrimaryButton}" Margin="0" IsDefault="True" Click="Replace_Click"/></StackPanel>
 </Grid>
</Window>
