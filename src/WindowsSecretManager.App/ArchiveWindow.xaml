<Window x:Class="WindowsSecretManager.App.ArchiveWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex Vault" Icon="Assets/codex-vault-selected.ico" Width="850" Height="625" MinWidth="760" MinHeight="600" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#0B0D14" Foreground="#F4F6FC">
 <Grid Margin="26,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock x:Name="HeadingText" Foreground="#F4F6FC" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="DescriptionText" Margin="0,6,0,0" Foreground="#A9B0C2"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="20">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock x:Name="ExportHeading" FontSize="18" FontWeight="SemiBold" Foreground="#F4F6FC"/>
     <StackPanel Grid.Row="1" Margin="0,7,0,18"><TextBlock x:Name="ExportDescription" Foreground="#A9B0C2"/><TextBlock x:Name="ExportCountText" Foreground="#8BE4C2" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
     <StackPanel Grid.Row="2"><CheckBox x:Name="ProtectExportCheck" Foreground="#F4F6FC" Checked="ProtectExportCheck_Changed" Unchecked="ProtectExportCheck_Changed"/><TextBlock x:Name="ExportPasswordLabel" Margin="0,14,0,6" Foreground="#C7CCDA"/><PasswordBox x:Name="ExportPasswordBox" Height="38"/><TextBlock x:Name="ConfirmPasswordLabel" Margin="0,12,0,6" Foreground="#C7CCDA"/><PasswordBox x:Name="ConfirmPasswordBox" Height="38"/></StackPanel>
     <Border x:Name="ExportWarningBorder" Grid.Row="3" VerticalAlignment="Bottom" Background="#2A2115" BorderBrush="#594522" BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,18,0,18"><TextBlock x:Name="ExportWarningText" Foreground="#E5C98B"/></Border>
     <Button x:Name="ExportButton" Grid.Row="4" Style="{StaticResource PrimaryButton}" Margin="0" HorizontalAlignment="Stretch" Click="Export_Click"/>
    </Grid>
   </Border>
   <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="20">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="ImportHeading" FontSize="18" FontWeight="SemiBold" Foreground="#F4F6FC"/>
     <TextBlock x:Name="ImportDescription" Grid.Row="1" Margin="0,7,0,14" Foreground="#A9B0C2"/>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ImportPathBox" Height="38" IsReadOnly="True"/><Button x:Name="BrowseButton" Grid.Column="1" Margin="8,0,0,0" Padding="12,7" Click="Browse_Click"/></Grid>
     <StackPanel Grid.Row="3"><TextBlock x:Name="ImportPasswordLabel" Margin="0,14,0,6" Foreground="#C7CCDA"/><PasswordBox x:Name="ImportPasswordBox" Height="38"/><TextBlock x:Name="ConflictLabel" Margin="0,14,0,6" Foreground="#C7CCDA"/><ComboBox x:Name="ConflictBox" Height="38"/></StackPanel>
     <StackPanel Grid.Row="4" VerticalAlignment="Bottom"><TextBlock x:Name="ArchiveInfoText" Margin="0,16,0,12" Padding="0,4,0,4" Foreground="#8BE4C2" LineHeight="23" LineStackingStrategy="BlockLineHeight"/><Button x:Name="ImportButton" Style="{StaticResource PrimaryButton}" Margin="0" HorizontalAlignment="Stretch" Click="Import_Click"/></StackPanel>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,18,0,0"><TextBlock x:Name="StatusText" Foreground="#A9B0C2" VerticalAlignment="Center"/><Button x:Name="CloseButton" HorizontalAlignment="Right" Margin="0" MinWidth="100" IsCancel="True"/></Grid>
 </Grid>
</Window>
