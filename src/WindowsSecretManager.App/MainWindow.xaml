<Window x:Class="WindowsSecretManager.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex Vault" Icon="Assets/codex-vault-selected.ico" Height="650" Width="960" MinHeight="570" MinWidth="820" WindowStartupLocation="CenterScreen" Background="#0B0D14" Foreground="#F4F6FC">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="24,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Image Source="Assets/codex-vault-selected-tight.png" Width="48" Height="48" Stretch="Uniform" Margin="0,0,14,0"/>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#F4F6FC" Text="Codex Vault"/><TextBlock x:Name="SubtitleText" Margin="0,3,0,0" Foreground="#A9B0C2"/></StackPanel>
   <Border Grid.Column="3" Background="#14241F" CornerRadius="12" Padding="12,7" Margin="0,0,12,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#4FD1A1" Margin="0,0,8,0"/><TextBlock Foreground="#8BE4C2" FontSize="12" FontWeight="SemiBold" Text="WINDOWS CREDENTIAL MANAGER"/></StackPanel></Border>
   <Border Grid.Column="4" Height="38" Background="#131722" BorderBrush="#282E40" BorderThickness="1" CornerRadius="9" Padding="3" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Button x:Name="PolishButton" Content="PL" Width="42" Padding="8,4" Margin="0" Foreground="#F4F6FC" Click="PolishButton_Click"/><Button x:Name="EnglishButton" Content="EN" Width="42" Padding="8,4" Margin="2,0,0,0" Foreground="#F4F6FC" Click="EnglishButton_Click"/></StackPanel></Border>
  </Grid></Border>
  <Grid Grid.Row="1" Margin="24,22,24,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,12"><TextBlock x:Name="ListHeadingText" FontSize="15" FontWeight="SemiBold" Foreground="#F4F6FC"/><TextBlock x:Name="NamesOnlyText" HorizontalAlignment="Right" Foreground="#A9B0C2"/></Grid>
   <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="FilterLabel" VerticalAlignment="Center" Foreground="#A9B0C2" Margin="0,0,12,0"/><TextBox x:Name="FilterBox" Grid.Column="1" Height="36" TextChanged="FilterBox_TextChanged"/></Grid>
   <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="6"><ListBox x:Name="SecretList" Background="Transparent" BorderThickness="0" Foreground="#F4F6FC" FontFamily="Cascadia Mono, Consolas" FontSize="13" SelectionChanged="SecretList_SelectionChanged" Padding="4" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="13,11"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="#F4F6FC"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="26" Height="26" CornerRadius="7" Background="#242039" Margin="0,0,12,0"><TextBlock Text="◆" Foreground="#9C8CFF" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter Grid.Column="1" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#292448"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox></Border>
   <Grid Grid.Row="3" Margin="0,14,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="AddButton" Style="{StaticResource PrimaryButton}" Click="Add_Click"/><Button x:Name="RotateButton" Click="Rotate_Click" IsEnabled="False"/><Button x:Name="RenameButton" Click="Rename_Click" IsEnabled="False"/><Button x:Name="RevealButton" Click="Reveal_Click" IsEnabled="False"/><Button x:Name="CopyButton" Click="Copy_Click" IsEnabled="False"/><Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" Click="Delete_Click" IsEnabled="False"/></StackPanel><Button x:Name="RefreshButton" HorizontalAlignment="Right" Margin="8,0,0,0" Click="Refresh_Click"/></Grid>
  </Grid>
  <Border Grid.Row="2" Background="#0F121B" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="24,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Foreground="#A9B0C2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0"><Hyperlink x:Name="AboutLink" Foreground="#A9B0C2" TextDecorations="{x:Null}" Cursor="Hand" Click="AboutLink_Click"><Run x:Name="AboutText"/></Hyperlink><Run Text="   |   " Foreground="#686F82"/><Run x:Name="StatusText"/></TextBlock><TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#686F82" Text="Codex.Shared/*  ·  SharedSecrets/*  ·  Vendor.Application/*" FontFamily="Cascadia Mono, Consolas"/></Grid></Border>
 </Grid>
</Window>
