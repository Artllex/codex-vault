<Window x:Class="WindowsSecretManager.App.RecoveryCodesDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex Vault" Icon="Assets/codex-vault-selected.ico" Width="720" MinWidth="650" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#0B0D14" Foreground="#F4F6FC">
 <Grid Margin="26,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock x:Name="HeadingText" Foreground="#F4F6FC" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="DescriptionText" Margin="0,6,0,0" Foreground="#A9B0C2"/></StackPanel>
  <StackPanel Grid.Row="1"><TextBlock x:Name="NameLabel" Foreground="#F4F6FC" FontWeight="SemiBold"/><TextBox x:Name="NameBox" Margin="0,7,0,7" Height="38" TextChanged="NamePart_Changed"/><TextBlock x:Name="FullNameText" Foreground="#8BE4C2" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,0,0,16"/></StackPanel>
  <StackPanel Grid.Row="2"><Grid Margin="0,0,0,7"><TextBlock x:Name="CodesLabel" Foreground="#F4F6FC" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="ImportButton" HorizontalAlignment="Right" Margin="0" Padding="12,6" Click="Import_Click"/></Grid><TextBox x:Name="CodesBox" Height="170" MaxLength="2560" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" SpellCheck.IsEnabled="False"/><TextBlock x:Name="CountText" Foreground="#A9B0C2" FontSize="12" Margin="0,7,0,18"/></StackPanel>
  <Border Grid.Row="3" Background="#2A2115" BorderBrush="#594522" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,20"><StackPanel><TextBlock x:Name="SourceWarningText" Foreground="#E5C98B" TextWrapping="Wrap"/><TextBlock x:Name="ClipboardWarningText" Foreground="#E5C98B" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" MinWidth="92" IsCancel="True"/><Button x:Name="SaveButton" MinWidth="160" Style="{StaticResource PrimaryButton}" Margin="0" IsDefault="True" Click="Save_Click"/></StackPanel>
 </Grid>
</Window>
