<Application x:Class="WindowsSecretManager.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml" ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <SolidColorBrush x:Key="Bg" Color="#0B0D14"/><SolidColorBrush x:Key="Surface" Color="#131722"/><SolidColorBrush x:Key="SurfaceHover" Color="#1B2030"/><SolidColorBrush x:Key="Border" Color="#282E40"/><SolidColorBrush x:Key="Text" Color="#F4F6FC"/><SolidColorBrush x:Key="Muted" Color="#9299AC"/><SolidColorBrush x:Key="Accent" Color="#7C6CF2"/><SolidColorBrush x:Key="AccentHover" Color="#9284FF"/><SolidColorBrush x:Key="Danger" Color="#F06B79"/>
  <Style TargetType="Window"><Setter Property="Background" Value="#0B0D14"/><Setter Property="Foreground" Value="#F4F6FC"/><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHover}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.76"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="{StaticResource Danger}"/><Setter Property="BorderBrush" Value="#4A2D37"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#0F121B"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="8,5"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0F121B"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="9,6"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0F121B"/><Setter Property="Foreground" Value="#F4F6FC"/><Setter Property="CaretBrush" Value="#F4F6FC"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="SelectionBrush" Value="{StaticResource Accent}"/><Setter Property="Padding" Value="9,6"/></Style>
 </Application.Resources>
</Application>
